      "textLayout": {
        "lineCount": 9,
        "lines": [
          {
            "index": 1,
            "text": "Ø课题2：基于视觉大/小模型融合的安全管控风险智能识别技术研究"
          },
          {
            "index": 2,
            "text": "（1）作业现场违章行为监测"
          },
          {
            "index": 3,
            "text": "面向现场安全监督场景，研究作业行为智能识别模型，对“未佩戴安全帽”“着"
          },
          {
            "index": 4,
            "text": "装不规范”“区域入侵”等典型违章行为开展低时延、高效率监测，提升现场风险发"
          },
          {
            "index": 5,
            "text": "现的实时性和准确性。"
          },
          {
            "index": 6,
            "text": "（2）视觉模型二级复核"
          },
          {
            "index": 7,
            "text": "研究视觉大/小模型协同的二级复核机制，由小模型进行快速筛查，对低置信"
          },
          {
            "index": 8,
            "text": "度结果或复杂场景自动触发大模型深度复核，提高复杂作业场景下风险判别能力并"
          },
          {
            "index": 9,
            "text": "降低误报率。"
          }
        ]
