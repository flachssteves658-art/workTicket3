# OpenAI-compatible LLM config (用于结构化识别的文本模型)
LLM_API_KEY=replace_with_your_key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# 视觉模型配置（图片直传大模型，独立配置；不填则回退到 LLM 配置）
VISION_API_KEY=replace_with_your_vision_key
VISION_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
VISION_MODEL=qwen3.7-plus

# Server config
APP_HOST=127.0.0.1
APP_PORT=8880
UPLOAD_DIR=storage/uploads
OUTPUT_DIR=storage/outputs
TICKET_STORE_DIR=storage/tickets
CATALOG_DIR=storage/catalog
MATCH_DIR=storage/matches
LLM_TIMEOUT_SECONDS=120

# 智能安监联动（与监控项目的 DB Management 服务保持一致）
HAZARD_DBM_BASE_URL=http://127.0.0.1:8005
# 请替换为随机长字符串；调用 /api/v1/* 接口时放入 X-Integration-Token 请求头
HAZARD_INTEGRATION_TOKEN=replace_with_a_long_random_token
INTEGRATION_TIMEOUT_SECONDS=15

# OCR performance knobs
# Keep JSON/Markdown artifacts for LLM input, but skip visual images and heavy raw dumps by default.
OCR_SAVE_JSON=1
OCR_SAVE_MARKDOWN=1
OCR_SAVE_VISUAL=0
OCR_COLLECT_RAW=0

# Windows CPU stable mode. The server OCR model can raise a native
# "RuntimeError: Unknown exception" on some machines, so use cached mobile
# detection/recognition models while retaining PPStructureV3 table parsing.
OCR_DEVICE=cpu
OCR_ENABLE_MKLDNN=0
OCR_CPU_THREADS=1
OCR_TEXT_DETECTION_MODEL=PP-OCRv4_mobile_det
OCR_TEXT_RECOGNITION_MODEL=PP-OCRv4_mobile_rec
OCR_USE_DOC_ORIENTATION=0
OCR_USE_DOC_UNWARPING=0
OCR_USE_TEXTLINE_ORIENTATION=0
OCR_USE_FORMULA_RECOGNITION=0
OCR_USE_CHART_RECOGNITION=0
OCR_USE_SEAL_RECOGNITION=0
